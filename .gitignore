# Локальный тулчейн: ~173 МБ бинарников движка. В репозиторий не идёт —
# версия движка зафиксирована в docs/architecture.md §1, качается отдельно.
tools/

# Исходная распаковка MCP-аддона в корне репозитория. Живая копия, которую
# грузит Godot, лежит в game/addons/godot_mcp/ и в репозиторий ВХОДИТ.
# Ведущий слеш обязателен: шаблон без него выбросил бы и game/addons.
/addons/

# Godot: кэш импорта и кэш глобальных классов (генерируются движком)
.godot/
game/.godot/

# Рабочие артефакты SDD: леджер, брифы, отчёты, диффы пакетов ревью
.superpowers/

*.tmp
*.log

# Архивы пакетов постановки: производные от docs/handoff/<пакет>/, собираются
# для передачи внешнему исполнителю и в истории репозитория не нужны.
docs/handoff/*.zip
