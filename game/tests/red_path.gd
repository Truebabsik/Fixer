extends RefCounted
## НАРОЧНО ПАДАЮЩИЙ кейс. Один ассерт верен, один — заведомо нет.
## Живёт ради того, чтобы «красный путь» раннера был защищён прогоном, а не
## честным словом: если приговор когда-нибудь зашьют константой, этот кейс
## перестанет валить процесс, и отдельный прогон это заметит.

const Assert := preload("res://tests/assert.gd")


func run() -> Array:
	var t := Assert.new()
	t.eq("верный ассерт", 2, 1 + 1)
	t.eq("нарочно неверный ассерт", 1, 2)
	return t.results
