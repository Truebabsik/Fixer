extends RefCounted
## Загрузчик контента: словарь или JSON → модель миссии.
##
## Зачем отдельный модуль. `sim/` не должен знать про JSON: там чистая логика графа.
## Всё, что связано с формой файла — отсутствующие поля, числа как float после разбора,
## приведение типов — живёт здесь и только здесь.
##
## Правило: сначала валидатор, потом сборка. Если словарь негоден, миссия НЕ собирается
## вовсе: полумиссия в ядре хуже отказа, потому что падает позже и непонятнее.

const Problems := preload("res://content/problems.gd")
const Validator := preload("res://content/validator.gd")
const Mission := preload("res://sim/mission.gd")
const Plan := preload("res://sim/plan.gd")


## Разбор строки JSON и загрузка. Возвращает тот же результат, что load_mission.
## Разбор идёт через `JSON` (а не `parse_string`), потому что только он знает строку
## и причину сбоя: автору нужно «строка 7: ожидалась запятая», а не «не разбирается».
##
## `texts` обязателен и значения по умолчанию не имеет — как у `validate`, и по той же
## причине: выбор «сверять ключи или нет» делает вызывающий, и он виден в строке вызова.
## Умолчание `{}` здесь было бы особенно вредным: по новой семантике это не «пропустить»,
## а «текстов нет», то есть миссия с любым `*_key` молча перестала бы грузиться.
static func load_text(json_text: String, texts) -> Dictionary:
	var json := JSON.new()
	var error := json.parse(json_text)
	if error != OK:
		return _fail(Problems.bad_json(error, json.get_error_line(), json.get_error_message()), texts)
	return load_mission(json.data, texts)


## Возвращает {"mission": Mission|null, "texts": что передал вызывающий, "problems": Array}.
## mission == null ровно тогда, когда problems непуст.
##
## `texts` обязателен (см. `validate`) и едет дальше БЕЗ искажения: что выбрал вызывающий
## — `null` («сверку не делаю») или словарь (в том числе пустой) — то и сверяется, и то же
## самое кладётся в payload миссии. Подменять `null` пустым словарём здесь нельзя: это
## превратило бы явный отказ в утверждение «текстов нет».
##
## Тип `Dictionary|null` у `texts` в ответе НЕ обещается: на пути отказа (непустые
## `problems`) в ответ попадает ровно переданное значение — в том числе не словарь, если
## вызывающий передал не словарь (строка, `Node`): там `_deep(texts)` копирует что дали.
## Поведение верное и одинаковое на обоих путях (ответ не подменяет выбор вызывающего),
## а обещание типа было бы враньём ровно про путь отказа.
static func load_mission(data, texts) -> Dictionary:
	var problems: Array = Validator.validate(data, texts)
	if not problems.is_empty():
		return {"mission": null, "texts": _deep(texts), "problems": problems}
	var mission := Mission.new()
	mission.id = String(data.get("id", ""))
	for node_id in data["nodes"]:
		var node: Dictionary = data["nodes"][node_id]
		mission.add_node(String(node_id), to_int(node["floor"]), _string_list(node.get("tags", [])))
	for e in data["edges"]:
		mission.add_edge(String(e["id"]), String(e["a"]), String(e["b"]), String(e["kind"]),
			to_int(e["steps"]), to_int(e["noise"]), bool(e.get("locked", false)))
	## Разделы-массивы могут быть чем угодно, если валидатор пропущен (или в нём дыра):
	## `for p in {}` идёт по ключам и падает рантаймом ВНУТРИ цикла. Здешняя проверка
	## типа — защита в глубину: загрузчик обязан завершиться, а не уйти в разнос.
	for p in _items(data, "patrols"):
		mission.add_patrol(String(p["id"]), _string_list(p["route"]), to_int(p.get("period", 4)))
	for s in _items(data, "sensors"):
		mission.add_sensor(String(s["id"]), _string_list(s["nodes"]))
	mission.objective = String(data["objective"])
	mission.set_data({
		"windows": _deep(_items(data, "windows")),
		"intel": _deep(_items(data, "intel")),
		"access_points": _deep(_items(data, "access_points")),
		## `_deep`, а не `texts.duplicate(true)`: при явном `null` копировать нечего —
		## `duplicate()` на `null` уронил бы вызов рантаймом, а подставить сюда `{}`
		## значило бы выдать отказ от сверки за утверждение «текстов нет».
		"texts": _deep(texts),
		## Название уровня едет тем же путём, что и остальные разделы: `title_key`
		## объявлен в `Mission.DATA_SECTIONS`, поэтому теряться ему негде.
		"title_key": String(data.get("title_key", "")),
	})
	return {"mission": mission, "texts": _deep(texts), "problems": []}


## Раздел-массив или пустой массив. Не массив — пусто: цикл по словарю пошёл бы
## по ключам и упал рантаймом ВНУТРИ цикла (ровно так выглядел дефект C1: валидатор
## молчал, а загрузчик уходил в разнос).
##
## Аннотации возврата `-> Array` здесь НЕТ намеренно. Она принуждала бы любой
## не-массив к `[]` — и тем самым делала охрану неотличимой от её отсутствия:
## проба «вернуть `data.get(section, [])`» с аннотацией давала бы тот же `[]`,
## и сломанная охрана проходила бы все проверки. Тип держит тело функции, а не
## подпись: так охрана проверяема, а поведение — то же.
static func _items(data: Dictionary, section: String):
	var value = data.get(section, [])
	if typeof(value) != TYPE_ARRAY:
		return []
	return value


## План грузится отдельно от миссии: он приходит из фазы планирования, а не из контента
## уровня. Отсутствующие поля — не ошибка: `Sim.setup` сам проверяет маршрут и скажет
## «маршрут пуст» понятнее, чем загрузчик. Валидатора у плана нет вовсе (в отличие от
## миссии, где «сначала валидатор, потом сборка»), поэтому защита в глубину здесь —
## ЕДИНСТВЕННАЯ: см. ниже.
##
## Контракт не меняется (возвращается `Plan`), потому что план — вход не только сюда: фаза
## планирования и задача об эквивалентности трёх путей строят его тем же способом, и второй
## формы ответа им пришлось бы учиться ради случая, которого у них нет.
##
## Политика на `agents` — ТРИ РАЗНЫХ случая, и разница между ними видна в коде:
##   * поля нет — состав из умолчания `Plan` (kira/echo): отсутствие утверждения про
##     состав — не утверждение «бойцов нет»;
##   * поле есть, но НЕ массив — мусор в поле: поле ИГНОРИРУЕТСЯ, остаётся умолчание
##     `Plan` (решение C1). Автор не сказал «вот бойцы» — он сломал форму поля, и
##     отбирать за это бойцов значило бы ту же тихую подмену, только с другой стороны;
##   * поле есть и это МАССИВ — список И ЕСТЬ ответ, в том числе пустой. `{"agents": []}`
##     значит «бойцов нет»: это осмысленное значение, и подменять его боевым составом
##     нельзя (прежний `if not parsed_agents.is_empty()` делал ровно это). Записи без
##     строкового `id` отбрасываются поштучно (`_plan_agents`), как и записи с уже
##     встречавшимся `id` — остаётся ПЕРВАЯ; если годных не осталось, состав пуст.
##     Молчаливая подстановка `""` в `id` недопустима, `Sim` пишет бойцов в один словарь
##     `positions`, и пустой id столкнулся бы с другим таким же. Повтор `id` — ровно та же
##     опасность с другой стороны: ключ в `positions` один, и второй боец исчез бы из
##     отчёта и дампа без единого сообщения.
##
## Цена решения названа прямо: мусор в `route` даёт пустой маршрут и громкое «маршрут пуст»
## из `Sim.setup` (`invalid_mission`), мусор в `exit_node` — пустой выход, о котором ядро
## сегодня молчит, а список `agents` из одних негодных записей — пустой состав, о котором
## `Sim.setup` тоже молчит (цикл по пустому списку не выполняется ни разу). Отчёт об этом
## нужен вызывающему (`problems`), но `load_plan` его не возвращает по решению выше;
## второй слой — задача об эквивалентности трёх путей.
static func load_plan(data: Dictionary) -> Plan:
	var plan := Plan.new()
	## `route` — единственный раздел плана, который `_string_list` пропускает через себя
	## как есть: не-массив даёт пустой маршрут, не-строки внутри массива отсеиваются.
	## Прежний `String(item)` на словаре внутри массива ронял вызов рантаймом.
	if data.has("route"):
		plan.route = _string_list(data["route"])
	## Выходы — `_string_of`, а не `String(...)`: конструктор `String` на не-строке —
	## не приведение, а рантайм-сбой движка (`Nonexistent 'String' constructor`), который
	## прерывает вызов до `quit()` и вешает прогон. Не-строка — поле не задано.
	if data.has("exit_node"):
		plan.exit_node = _string_of(data["exit_node"])
	if data.has("exit_backup_node"):
		plan.exit_backup_node = _string_of(data["exit_backup_node"])
	## Флаг берётся только честным bool: `bool("да")` — ошибка движка в логе, а не значение.
	## Не-bool здесь не ошибка (`load_plan` отсутствующие и чужие поля не судит), но и не флаг.
	if data.has("cargo_heavy") and typeof(data["cargo_heavy"]) == TYPE_BOOL:
		plan.cargo_heavy = bool(data["cargo_heavy"])
	## `agents`: см. политику выше — массив уважается целиком (в том числе пустой),
	## не-массив игнорируется и оставляет умолчание `Plan`.
	if data.has("agents") and typeof(data["agents"]) == TYPE_ARRAY:
		plan.agents = _plan_agents(data["agents"])
	return plan


## Состав плана: список записей агента. Запись без СТРОКОВОГО непустого `id` смысла не
## имеет (по id ядро ведёт бойца) и отбрасывается ЦЕЛИКОМ: подставить `""` нельзя — `Sim`
## пишет бойцов в один словарь `positions`, и пустой id столкнулся бы с другим таким же.
## У остальных полей мусор заменяется умолчанием `Plan` (`tactician`, Понимание 3), а не нулём.
##
## Повтор `id` — та же опасность с ДРУГОЙ стороны, и она тоже закрыта отбраковкой: ключ
## в `positions` один на всех, поэтому две записи с одним id неразличимы для ядра — второй
## боец исчез бы из отчёта и дампа без единого сообщения. Остаётся ПЕРВАЯ запись: порядок
## записи задаёт приоритет (объявленный раньше и есть боец), а не «побеждает последний» —
## иначе состав молча зависел бы от порядка строк в файле. Пустой `id` и повтор равны
## в одном: запись отбрасывается ЦЕЛИКОМ, а не подменяется догадкой.
##
## Пустой результат функция НЕ трактует: `[]` выходит и для `[]`, и для списка из одних
## негодных записей. Решение «список объявлен явно, значит он и есть ответ» принимает
## `load_plan`: верни его сюда — и разница между `[]` и мусором в поле стёрлась бы.
##
## `understanding` специально НЕ доезжает до ядра как null: `to_int` (I5) отдаёт null на
## не-число и на дробное, а `sim.gd` читает поле через `int(...)`, и `int(null)` — это
## молчаливый НОЛЬ. Боец с нулевым Пониманием без единого сообщения меняет смысл найма
## (D9/D31), поэтому негодное значение не переносится в запись вовсе — остаётся умолчание.
static func _plan_agents(value) -> Array:
	var out: Array = []
	if typeof(value) != TYPE_ARRAY:
		return out
	## Множество уже принятых id — тот же словарь-множество, что `_known_ids` в валидаторе.
	## Отдельно от `out`, чтобы не искать по списку записей на каждом шаге.
	var seen: Dictionary = {}
	for a in (value as Array):
		if typeof(a) != TYPE_DICTIONARY:
			continue
		var id := _string_of(a.get("id", ""))
		if id == "":
			continue
		if seen.has(id):
			continue
		seen[id] = true
		var understanding: Variant = to_int(a.get("understanding", 3))
		var agent := {
			"id": id,
			"role": _string_of(a.get("role", "tactician"), "tactician"),
		}
		if understanding != null:
			agent["understanding"] = int(understanding)
		out.append(agent)
	return out


## Число как int. JSON в Godot отдаёт числа float, а `add_*` типизированы: без
## приведения движок откажется принимать значение.
##
## Всё, что не число, — null, а не 0. Прежний «тихий ноль» превращал мусор в валидное
## значение: строка «много» становилась нулевым шумом, словарь — нулевым периодом.
## Вызывающий обязан решить, что делать; молчаливое значение из мусора недопустимо (I5).
## Дробное число тоже null: 1.5 шага — не «два шага», а ошибка формы.
static func to_int(value):
	if typeof(value) == TYPE_INT:
		return int(value)
	if typeof(value) == TYPE_FLOAT:
		if not is_equal_approx(value, floor(value)):
			return null
		return int(value)
	return null


## Строка, а не строка — пустая. Конструктор `String(...)` на не-строке роняет вызов
## рантаймом (`Nonexistent 'String' constructor`), поэтому здесь только проверка типа:
## привести «что угодно к строке» движок не умеет, а подставить пустую — умеем мы.
static func _string_of(value, fallback := "") -> String:
	if typeof(value) != TYPE_STRING:
		return fallback
	return String(value)


## Список строк. Не массив — пустой список. Не-строка внутри массива ОТСЕИВАЕТСЯ, а не
## приводится: `String(item)` на словаре или массиве — тот же рантайм-сбой, что и в
## `load_plan`, и охрана «не массив» от него не спасала (`route = [{}]` ронял вызов).
## Контракт не меняется: валидатор миссии такие элементы и так не пропускает, а плану
## список нужен строками — элемент, который строкой не является, в маршруте не помещение.
static func _string_list(value) -> Array:
	var out: Array = []
	if typeof(value) != TYPE_ARRAY:
		return out
	for item in value:
		if typeof(item) != TYPE_STRING:
			continue
		out.append(String(item))
	return out


static func _deep(value):
	return value.duplicate(true) if value is Array or value is Dictionary else value


## Одна проблема — и миссии нет. Причина уже внутри проблемы: отдельный текстовый
## довод `why` был вторым, необязательным и всегда игнорируемым источником правды.
##
## `texts` возвращается ТЕМ ЖЕ, что передал вызывающий, и на отказе тоже: ответ не
## подменяет его выбор. Прежний `{}` в этом месте сообщал «текстов нет» тому, кто
## сказал «сверку не делаю», — та же тихая подмена, только на пути отказа.
static func _fail(problem: Dictionary, texts) -> Dictionary:
	return {"mission": null, "texts": _deep(texts), "problems": [problem]}
