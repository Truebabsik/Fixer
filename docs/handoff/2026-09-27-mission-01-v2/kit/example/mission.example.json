        { "id": "force", "text_key": "window.w_archivist.force", "complexity": 1,
          "cost": { "noise": 8, "delay": 1 },
          "effects": [{ "type": "unlock", "edge": "e_hall0_archive0" }],
          "note": "грубая сила: быстро и громко" }
